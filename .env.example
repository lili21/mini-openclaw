# OpenAI Configuration
OPENAI_API_KEY=your_api_key
BASE_URL=https://api.openai.com/v1

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Feishu Bot (optional)
# 使用 lark-oapi SDK 的 WebSocket 客户端
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxx
# FEISHU_ENCRYPT_KEY=optional_encrypt_key
# FEISHU_VERIFICATION_TOKEN=optional_verification_token
# 机器人 open_id（用于群聊过滤，只响应 @机器人 的消息）
# 可在飞书开放平台 -> 应用信息 -> 机器人配置 中查看
# FEISHU_BOT_OPEN_ID=ou_xxxxxxxxxxxxx

# Feishu 流式卡片输出
FEISHU_STREAM_OUTPUT=true
FEISHU_STREAM_OUTPUT_INTERVAL_MS=1200
FEISHU_STREAM_OUTPUT_FLUSH_CHARS=100

# Development Settings
# 设置为 true 禁用 SSL 证书验证（仅开发测试环境使用！）
# DISABLE_SSL_VERIFY=true
